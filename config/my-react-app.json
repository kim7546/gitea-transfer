{
  "projectName": "my-react-app",
  "allowedAuthorEmails": [
    "YOUR_GIT_AUTHOR_EMAIL@example.com"
  ],
  "includePaths": [
    "src",
    "server",
    "public",
    "package.json",
    "package-lock.json",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json"
  ],
  "excludeExtensions": [
    ".log",
    ".tmp",
    ".bak"
  ],
  "external": {
    "remote": "origin",
    "profiles": {
      "test": {
        "sourceBranch": "feature-test"
      },
      "prod": {
        "sourceBranch": "main"
      }
    }
  },
  "internal": {
    "remote": "origin",
    "mainBranch": "main",
    "importBranchPrefix": "feature/import-",
    "autoPush": true
  }
}
